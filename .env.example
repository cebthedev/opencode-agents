# OpenCode Agents Environment Configuration
# Copy this file to ~/.config/opencode/.env and fill in your API keys

# ============================================
# REQUIRED API Keys
# ============================================

# OpenCodeGo / ZAI Provider API Key
# Used for: GLM-5, GLM-5.1, Kimi K2.5, Kimi K2.6, MiMo models, MiniMax, Qwen, DeepSeek
# Get yours from: https://opencode.ai
OPENAI_API_KEY=your-opencodego-api-key-here

# Moonshot AI (Kimi Subscription)
# Used for: kimi-k2.6, kimi-k2.5 via direct API
# Get yours from: https://platform.moonshot.cn
MOONSHOT_API_KEY=your-moonshot-api-key-here

# ============================================
# OPTIONAL API Keys
# ============================================

# GitHub Token (for GitHub MCP)
# Required for: PR management, issue tracking, repo operations
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token-here

# Google Search API (for Google Search MCP)
# Required for: Enhanced web search capabilities
# Get from: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id-here

# Perplexity API (for advanced research search)
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# ============================================
# Configuration Notes
# ============================================

# Model Provider Mapping:
# - opencode-go/* : Uses OPENAI_API_KEY
# - moonshot-ai/* : Uses MOONSHOT_API_KEY
#
# Primary Agents:
# - build: Uses GLM-5.1 (coding)
# - research: Uses Kimi K2.6 (research)
# - plan: Uses GLM-5 (planning)
#
# Subagents:
# - coder: GLM-5.1
# - clean-coder: Kimi K2.6
# - code-reviewer: Kimi K2.6
# - beagle: GLM-5.1
# - paper-analyst: DeepSeek V4 Pro
# - researcher: Kimi K2.6
# - architect: GLM-5
# - writer: GLM-5
# - data-scientist: Qwen 3.6 Plus
