# OpenCode Agents Environment Configuration
# Copy this file to ~/.config/opencode/.env and fill in your API keys

# ============================================
# REQUIRED API Keys
# ============================================

# OpenCode Free Provider API Key (Zen endpoint)
# Used for: DeepSeek-V4-Flash-Free, MiMo-V2.5-Free, Qwen-3.6-Plus-Free,
#           North-Mini-Code-Free, Nemotron-3-Ultra-Free, MiniMax-M3-Free, Big-Pickle
# Get yours from: https://opencode.ai
OPENAI_API_KEY=your-opencode-api-key-here

# Moonshot AI / Kimi OAuth (Kimi Subscription)
# Used for: kimi-k2.7, kimi-k2.6, kimi-k2.5 via OAuth provider
# Provider ID: kimi-for-coding-oauth
# Get yours from: https://platform.moonshot.cn
MOONSHOT_API_KEY=your-moonshot-api-key-here

# ============================================
# DeepSeek (direct API - free tier available)
# Used for: deepseek-chat, deepseek-reasoner
# Get yours from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ============================================
# OPTIONAL API Keys
# ============================================

# GitHub Token (for GitHub MCP)
# Required for: PR management, issue tracking, repo operations
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token-here

# Google Search API (for Google Search MCP)
# Required for: Enhanced web search capabilities
# Get from: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id-here

# ============================================
# Configuration Notes
# ============================================

# Model Provider Mapping:
# - opencode/*              : Uses OPENAI_API_KEY (Zen endpoint, free models)
# - kimi-for-coding-oauth/* : Uses MOONSHOT_API_KEY (Kimi OAuth provider)
# - deepseek/*              : Uses DEEPSEEK_API_KEY
#
# Primary Agents (default models):
# - build: Uses Kimi K2.7 (coding)
# - research: Uses Kimi K2.7 (research)
# - plan: Uses Kimi K2.7 (planning, high reasoning)
#
# Subagents:
# - coder: Kimi K2.7
# - clean-coder: Kimi K2.7
# - code-reviewer: Kimi K2.7 (high reasoning)
# - beagle: OpenCode MiMo-V2.5-Free (fast research)
# - paper-analyst: DeepSeek Chat
# - researcher: Kimi K2.7 (high reasoning)
# - architect: DeepSeek Reasoner
# - writer: Kimi K2.7
# - data-scientist: DeepSeek Reasoner
# - cavecrew-builder: Kimi K2.7
# - cavecrew-investigator: Kimi K2.7
# - cavecrew-reviewer: Kimi K2.7
